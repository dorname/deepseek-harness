# cluster-web Compose / supervise defaults.
# Smoke and staging MUST keep replicas at 1 unless diagnosing scale; hard cap is 2.

PUBLIC_URL=http://127.0.0.1:8080/
TRUSTED_HOST=127.0.0.1:8080
EDGE_PORT=8080
# Shell (SPA) loopback port; edge STATIC_UPSTREAM points here (S46).
SHELL_PORT=3079
# First API-only loopback port (3080, 3081, …).
API_BASE_PORT=3080

# Shared Postgres (compose service name `postgres` on the compose network).
DATABASE_URL=postgres://dsh:dsh@127.0.0.1:5432/dsh

# Acceptance / smoke defaults — do not raise for routine verify (hard cap 2).
# Fe-split smoke: 1 shell + API_REPLICAS=1 + RUNNER_REPLICAS=0.
API_REPLICAS=1
RUNNER_REPLICAS=0

# Optional: path to a built apps/web dist index.html; empty = web-app default.
# DSH_FRONTEND_DIST_INDEX=

# Cluster config is read-only (disables HMR).
DSH_CONFIG_READONLY=1

# Host CPU ceiling (%) for smoke; mirrors scripts/fleet-staging/staging.config.json.
CPU_THRESHOLD_PERCENT=80
