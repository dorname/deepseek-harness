{
  "name": "@deepseek-ai/dsh-acp-network",
  "description": "Network ACP (Agent Client Protocol) transport for DeepSeek Harness over WebSocket and Streamable HTTP",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp-network"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
